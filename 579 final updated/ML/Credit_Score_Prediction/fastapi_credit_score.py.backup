    Returns information about the features expected by the model
    """
    return {
        "total_features": 46,
        "required_features": {
            "numerical": [
                "month", "age", "annual_income", "monthly_inhand_salary",
                "credit_history_age", "total_emi_per_month", "num_bank_accounts",
                "num_credit_card", "interest_rate", "num_of_loan",
                "delay_from_due_date", "num_of_delayed_payment",
                "changed_credit_limit", "num_credit_inquiries",
                "outstanding_debt", "credit_utilization_ratio",
                "amount_invested_monthly", "monthly_balance"
            ],
            "categorical_encoded": [
                "credit_mix", "payment_of_min_amount", "payment_behaviour"
            ],
            "loan_types": [
                "auto_loan", "credit_builder_loan", "debt_consolidation_loan",
                "no_loan", "not_specified", "payday_loan", "personal_loan"
            ],
            "occupations": [
                "occupation_accountant", "occupation_architect", "occupation_developer",
                "occupation_doctor", "occupation_engineer", "occupation_entrepreneur",
                "occupation_journalist", "occupation_lawyer", "occupation_manager",
                "occupation_mechanic", "occupation_media_manager", "occupation_musician",
                "occupation_scientist", "occupation_teacher", "occupation_writer"
            ]
        },
        "output_classes": {
            "0": "Poor",
            "1": "Standard",
            "2": "Good"
        }
    }

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8000)