@app.post("/crypto/portfolio/{user_id}/add")
async def add_to_portfolio(
    user_id: str,
    holding: PortfolioHolding
):
    """Add cryptocurrency to user's portfolio"""
    try:
        # Load existing portfolio or create new one
        portfolio = storage.load_portfolio(user_id)
        if not portfolio:
            portfolio = Portfolio(
                user_id=user_id,
                holdings={},
                total_value_usd=0,
                total_change_24h=0,
                total_change_percentage_24h=0,
                created_at=datetime.now().isoformat(),
                updated_at=datetime.now().isoformat()
            )
        
        # Add or update holding
        if holding.symbol in portfolio.holdings:
            # Update existing holding (add to quantity)
            portfolio.holdings[holding.symbol] += holding.quantity
        else:
            # Add new holding
            portfolio.holdings[holding.symbol] = holding.quantity
        
        portfolio.updated_at = datetime.now().isoformat()
        
        # Update portfolio value with current prices
        updated_portfolio = await portfolio_manager.update_portfolio_value(user_id)
        
        return {
            "success": True,
            "data": updated_portfolio,
            "message": f"Added {holding.quantity} {holding.symbol} to portfolio"
        }
    
    except Exception as e:
        logger.error(f"Error adding to portfolio: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to add to portfolio: {str(e)}")

@app.delete("/crypto/portfolio/{user_id}/{symbol}")
async def remove_from_portfolio(
    user_id: str,
    symbol: str,
    quantity: Optional[float] = Query(None, description="Quantity to remove (if not specified, removes all)")
):
    """Remove cryptocurrency from user's portfolio"""
    try:
        portfolio = storage.load_portfolio(user_id)
        if not portfolio:
            raise HTTPException(status_code=404, detail="Portfolio not found")
        
        if symbol not in portfolio.holdings:
            raise HTTPException(status_code=404, detail=f"'{symbol}' not found in portfolio")
        
        if quantity is None:
            # Remove entire holding
            del portfolio.holdings[symbol]
            message = f"Removed all {symbol} from portfolio"
        else:
            # Remove specified quantity
            if quantity >= portfolio.holdings[symbol]:
                del portfolio.holdings[symbol]
                message = f"Removed all {symbol} from portfolio"
            else:
                portfolio.holdings[symbol] -= quantity
                message = f"Removed {quantity} {symbol} from portfolio"
        
        portfolio.updated_at = datetime.now().isoformat()
        
        # Update portfolio value
        updated_portfolio = await portfolio_manager.update_portfolio_value(user_id)
        
        return {
            "success": True,
            "data": updated_portfolio,
            "message": message
        }
    
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error removing from portfolio: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to remove from portfolio: {str(e)}")

# Technical Analysis Endpoints
@app.get("/crypto/analysis/{symbol}")
async def get_technical_analysis(
    symbol: str,
    timeframe: TimeFrame = TimeFrame.DAY_1,
    indicators: List[TechnicalIndicator] = Query(
        default=[TechnicalIndicator.RSI, TechnicalIndicator.MACD, TechnicalIndicator.SMA],
        description="Technical indicators to calculate"
    )
):
    """Get comprehensive technical analysis for a cryptocurrency"""
    try:
        # Determine days based on timeframe
        days_mapping = {
            TimeFrame.MINUTE_1: 1,
            TimeFrame.MINUTE_5: 1,
            TimeFrame.MINUTE_15: 2,
            TimeFrame.HOUR_1: 7,
            TimeFrame.HOUR_4: 30,
            TimeFrame.DAY_1: 90,
            TimeFrame.WEEK_1: 365
        }
        
        days = days_mapping.get(timeframe, 30)
        
        # Get historical data
        price_data = await data_provider.get_historical_data(symbol, days)
        if not price_data:
            raise HTTPException(status_code=404, detail=f"No data available for '{symbol}'")
        
        # Calculate indicators
        indicator_names = [ind.value for ind in indicators]
        calculated_indicators = technical_analyzer.calculate_indicators(price_data, indicator_names)
        
        # Generate signals
        signals = technical_analyzer.generate_signals(calculated_indicators)
        
        # Create analysis summary
        analysis = TechnicalAnalysis(
            symbol=symbol,
            timeframe=timeframe,
            indicators=calculated_indicators,
            signals=signals,
            analysis_time=datetime.now().isoformat()
        )
        
        # Generate overall recommendation
        buy_signals = sum(1 for signal in signals.values() if signal == "buy")
        sell_signals = sum(1 for signal in signals.values() if signal == "sell")
        
        if buy_signals > sell_signals:
            overall_signal = "buy"
        elif sell_signals > buy_signals:
            overall_signal = "sell"
        else:
            overall_signal = "hold"
        
        return {
            "success": True,
            "data": {
                "analysis": analysis,
                "overall_signal": overall_signal,
                "signal_strength": abs(buy_signals - sell_signals) / max(len(signals), 1),
                "summary": {
                    "buy_signals": buy_signals,
                    "sell_signals": sell_signals,
                    "hold_signals": len(signals) - buy_signals - sell_signals
                }
            },
            "timestamp": datetime.now().isoformat()
        }
    
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error analyzing {symbol}: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to analyze: {str(e)}")

@app.get("/crypto/screener")
async def crypto_screener(
    min_market_cap: Optional[float] = Query(None, description="Minimum market cap"),
    max_market_cap: Optional[float] = Query(None, description="Maximum market cap"),
    min_volume: Optional[float] = Query(None, description="Minimum 24h volume"),
    min_change: Optional[float] = Query(None, description="Minimum 24h price change %"),
    max_change: Optional[float] = Query(None, description="Maximum 24h price change %"),
    limit: int = Query(50, le=100, description="Maximum number of results")
):
    """Screen cryptocurrencies based on criteria"""
    try:
        # Get data for top cryptocurrencies
        top_cryptos = [
            "bitcoin", "ethereum", "binancecoin", "cardano", "solana",
            "polkadot", "dogecoin", "avalanche-2", "matic-network", "chainlink",
            "litecoin", "bitcoin-cash", "stellar", "vechain", "filecoin",
            "tron", "ethereum-classic", "monero", "eos", "aave"
        ]
        
        prices = await data_provider.get_crypto_prices(top_cryptos)
        
        # Apply filters
        filtered_cryptos = []
        for symbol, price_data in prices.items():
            # Market cap filter
            if min_market_cap and (not price_data.market_cap or price_data.market_cap < min_market_cap):
                continue
            if max_market_cap and (not price_data.market_cap or price_data.market_cap > max_market_cap):
                continue
            
            # Volume filter
            if min_volume and (not price_data.volume_24h or price_data.volume_24h < min_volume):
                continue
            
            # Price change filter
            if min_change and (not price_data.price_change_percentage_24h or price_data.price_change_percentage_24h < min_change):
                continue
            if max_change and (not price_data.price_change_percentage_24h or price_data.price_change_percentage_24h > max_change):
                continue
            
            filtered_cryptos.append(price_data)
        
        # Sort by market cap (descending)
        filtered_cryptos.sort(key=lambda x: x.market_cap or 0, reverse=True)
        
        # Limit results
        filtered_cryptos = filtered_cryptos[:limit]
        
        return {
            "success": True,
            "data": filtered_cryptos,
            "count": len(filtered_cryptos),
            "filters_applied": {
                "min_market_cap": min_market_cap,
                "max_market_cap": max_market_cap,
                "min_volume": min_volume,
                "min_change": min_change,
                "max_change": max_change
            },
            "timestamp": datetime.now().isoformat()
        }
    
    except Exception as e:
        logger.error(f"Error screening cryptos: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to screen cryptocurrencies: {str(e)}")

# Alert Endpoints
@app.post("/crypto/alerts")
async def create_price_alert(
    user_id: str = Query(..., description="User ID"),
    symbol: str = Query(..., description="Cryptocurrency symbol"),
    alert_type: AlertType = Query(..., description="Type of alert"),
    target_value: float = Query(..., description="Target price or percentage")
):
    """Create a new price alert"""
    try:
        # Validate symbol exists
        prices = await data_provider.get_crypto_prices([symbol])
        if symbol not in prices:
            raise HTTPException(status_code=404, detail=f"Cryptocurrency '{symbol}' not found")
        
        current_price = prices[symbol].current_price
        
        # Create new alert
        alert = PriceAlert(
            alert_id=str(uuid.uuid4()),
            user_id=user_id,
            symbol=symbol,
            alert_type=alert_type,
            target_value=target_value,
            current_value=current_price,
            is_active=True,
            created_at=datetime.now().isoformat()
        )
        
        # Load existing alerts and add new one
        alerts = storage.load_alerts(user_id)
        alerts.append(alert)
        storage.save_alerts(user_id, alerts)
        
        return {
            "success": True,
            "data": alert,
            "message": f"Alert created for {symbol}"
        }
    
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error creating alert: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to create alert: {str(e)}")

