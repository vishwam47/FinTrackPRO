# Configuration
class Settings:
    COINGECKO_BASE_URL = "https://api.coingecko.com/api/v3"
    BINANCE_BASE_URL = "https://api.binance.com/api/v3"
    DATA_DIR = "data/crypto"
    RATE_LIMIT_PER_MINUTE = 30
    CACHE_DURATION_SECONDS = 60

settings = Settings()

# Create data directory
