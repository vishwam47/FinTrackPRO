# Pydantic Models
class CryptoCurrency(str, Enum):
    BITCOIN = "bitcoin"
    ETHEREUM = "ethereum"
    BINANCECOIN = "binancecoin"
    CARDANO = "cardano"
    SOLANA = "solana"
    POLKADOT = "polkadot"
    DOGECOIN = "dogecoin"
    AVALANCHE_2 = "avalanche-2"
    POLYGON = "matic-network"
    CHAINLINK = "chainlink"

class TimeFrame(str, Enum):
    MINUTE_1 = "1m"
    MINUTE_5 = "5m"
    MINUTE_15 = "15m"
    HOUR_1 = "1h"
    HOUR_4 = "4h"
    DAY_1 = "1d"
    WEEK_1 = "1w"

class TechnicalIndicator(str, Enum):
    SMA = "sma"
    EMA = "ema"
    RSI = "rsi"
    MACD = "macd"
    BOLLINGER_BANDS = "bb"
    STOCHASTIC = "stoch"

class AlertType(str, Enum):
    PRICE_ABOVE = "price_above"
    PRICE_BELOW = "price_below"
    PERCENT_CHANGE = "percent_change"
    TECHNICAL_SIGNAL = "technical_signal"

class CryptoPrice(BaseModel):
    symbol: str
    name: str
    current_price: float
    market_cap: Optional[float]
    volume_24h: Optional[float]
    price_change_24h: Optional[float]
    price_change_percentage_24h: Optional[float]
    last_updated: str

class Portfolio(BaseModel):
    user_id: str
    holdings: Dict[str, float]  # {symbol: quantity}
    total_value_usd: float
    total_change_24h: float
    total_change_percentage_24h: float
    created_at: str
    updated_at: str

class PortfolioHolding(BaseModel):
    symbol: str = Field(..., description="Cryptocurrency symbol")
    quantity: float = Field(..., gt=0, description="Amount owned")
    purchase_price: Optional[float] = Field(None, description="Average purchase price")

class PriceAlert(BaseModel):
    alert_id: str
    user_id: str
    symbol: str
    alert_type: AlertType
    target_value: float
    current_value: float
    is_active: bool
    created_at: str
    triggered_at: Optional[str] = None

class TechnicalAnalysis(BaseModel):
    symbol: str
    timeframe: TimeFrame
    indicators: Dict[str, Any]
    signals: Dict[str, str]  # buy/sell/hold signals
    analysis_time: str

class MarketData(BaseModel):
    symbol: str
    price_data: List[List[float]]  # [timestamp, open, high, low, close, volume]
    indicators: Optional[Dict[str, List[float]]] = None

# Rate Limiting and Caching
class RateLimiter:
    def __init__(self):
        self.calls = []
        self.max_calls_per_minute = settings.RATE_LIMIT_PER_MINUTE
    
    async def wait_if_needed(self):
        now = time.time()
        # Remove calls older than 1 minute
        self.calls = [call_time for call_time in self.calls if now - call_time < 60]
        
        if len(self.calls) >= self.max_calls_per_minute:
            sleep_time = 60 - (now - self.calls[0])
            if sleep_time > 0:
                logger.info(f"Rate limit reached, sleeping for {sleep_time:.2f} seconds")
                await asyncio.sleep(sleep_time)
        
        self.calls.append(now)

class CacheManager:
    def __init__(self):
        self.cache = {}
        self.cache_timestamps = {}
    
    def get(self, key: str):
        if key in self.cache:
            if time.time() - self.cache_timestamps[key] < settings.CACHE_DURATION_SECONDS:
                return self.cache[key]
            else:
                del self.cache[key]
                del self.cache_timestamps[key]
        return None
    
    def set(self, key: str, value: Any):
        self.cache[key] = value
        self.cache_timestamps[key] = time.time()

# Initialize rate limiter and cache
rate_limiter = RateLimiter()
cache_manager = CacheManager()

# File Storage Manager
class CryptoStorageManager:
    def __init__(self, base_dir: str):
        self.base_dir = base_dir
    
    def get_user_dir(self, user_id: str) -> str:
        user_dir = os.path.join(self.base_dir, user_id)
        os.makedirs(user_dir, exist_ok=True)
        return user_dir
    
    def save_portfolio(self, user_id: str, portfolio: Portfolio):
        user_dir = self.get_user_dir(user_id)
        file_path = os.path.join(user_dir, "portfolio.json")
        
        with open(file_path, "w") as f:
            json.dump(portfolio.dict(), f, indent=2)
    
    def load_portfolio(self, user_id: str) -> Optional[Portfolio]:
        user_dir = self.get_user_dir(user_id)
        file_path = os.path.join(user_dir, "portfolio.json")
        
        if not os.path.exists(file_path):
            return None
        
        try:
            with open(file_path, "r") as f:
                portfolio_data = json.load(f)
            return Portfolio(**portfolio_data)
        except Exception as e:
            logger.error(f"Error loading portfolio for user {user_id}: {str(e)}")
            return None
    
    def save_alerts(self, user_id: str, alerts: List[PriceAlert]):
        user_dir = self.get_user_dir(user_id)
        file_path = os.path.join(user_dir, "alerts.json")
        
        alerts_data = [alert.dict() for alert in alerts]
        with open(file_path, "w") as f:
            json.dump(alerts_data, f, indent=2)
    
    def load_alerts(self, user_id: str) -> List[PriceAlert]:
        user_dir = self.get_user_dir(user_id)
        file_path = os.path.join(user_dir, "alerts.json")
        
        if not os.path.exists(file_path):
            return []
        
        try:
            with open(file_path, "r") as f:
                alerts_data = json.load(f)
            return [PriceAlert(**alert) for alert in alerts_data]
        except Exception as e:
            logger.error(f"Error loading alerts for user {user_id}: {str(e)}")
            return []

# Initialize storage
storage = CryptoStorageManager(settings.DATA_DIR)

# Market Data Provider
class CryptoDataProvider:
    def __init__(self):
        self.coingecko_url = settings.COINGECKO_BASE_URL
        self.binance_url = settings.BINANCE_BASE_URL
    
    async def get_crypto_prices(self, symbols: List[str]) -> Dict[str, CryptoPrice]:
        """Get current prices from CoinGecko API"""
        cache_key = f"prices_{','.join(sorted(symbols))}"
        cached_data = cache_manager.get(cache_key)
        if cached_data:
            return cached_data
        
        await rate_limiter.wait_if_needed()
        
        try:
            url = f"{self.coingecko_url}/simple/price"
            params = {
                "ids": ",".join(symbols),
                "vs_currencies": "usd",
                "include_market_cap": "true",
                "include_24hr_vol": "true",
                "include_24hr_change": "true",
                "include_last_updated_at": "true"
            }
            
            async with httpx.AsyncClient(timeout=30.0) as client:
                response = await client.get(url, params=params)
                response.raise_for_status()
                data = response.json()
            
            # Convert to CryptoPrice objects
            prices = {}
            for symbol, price_data in data.items():
                prices[symbol] = CryptoPrice(
                    symbol=symbol,
                    name=symbol.replace("-", " ").title(),
                    current_price=price_data["usd"],
                    market_cap=price_data.get("usd_market_cap"),
                    volume_24h=price_data.get("usd_24h_vol"),
                    price_change_24h=price_data.get("usd_24h_change"),
                    price_change_percentage_24h=price_data.get("usd_24h_change"),
                    last_updated=datetime.now().isoformat()
                )
            
            cache_manager.set(cache_key, prices)
            return prices
            
        except Exception as e:
            logger.error(f"Error fetching prices from CoinGecko: {str(e)}")
            # Fallback to Binance for basic price data
            return await self._get_binance_fallback_prices(symbols)
    
    async def _get_binance_fallback_prices(self, symbols: List[str]) -> Dict[str, CryptoPrice]:
        """Fallback to Binance API for basic price data"""
        try:
            url = f"{self.binance_url}/ticker/24hr"
            
            async with httpx.AsyncClient(timeout=30.0) as client:
                response = await client.get(url)
                response.raise_for_status()
                data = response.json()
            
            # Map Binance symbols to CoinGecko format
            symbol_mapping = {
                "BTCUSDT": "bitcoin",
                "ETHUSDT": "ethereum",
                "BNBUSDT": "binancecoin",
                "ADAUSDT": "cardano",
                "SOLUSDT": "solana"
            }
            
            prices = {}
            for item in data:
                binance_symbol = item["symbol"]
                if binance_symbol in symbol_mapping:
                    coingecko_symbol = symbol_mapping[binance_symbol]
                    if coingecko_symbol in symbols:
                        prices[coingecko_symbol] = CryptoPrice(
                            symbol=coingecko_symbol,
                            name=coingecko_symbol.replace("-", " ").title(),
                            current_price=float(item["lastPrice"]),
                            market_cap=None,
                            volume_24h=float(item["volume"]),
                            price_change_24h=float(item["priceChange"]),
                            price_change_percentage_24h=float(item["priceChangePercent"]),
                            last_updated=datetime.now().isoformat()
                        )
            
            return prices
            
        except Exception as e:
            logger.error(f"Binance fallback also failed: {str(e)}")
            return {}
    
    async def get_historical_data(self, symbol: str, days: int = 30) -> List[List[float]]:
        """Get historical price data from CoinGecko"""
        cache_key = f"history_{symbol}_{days}"
        cached_data = cache_manager.get(cache_key)
        if cached_data:
            return cached_data
        
        await rate_limiter.wait_if_needed()
        
        try:
            url = f"{self.coingecko_url}/coins/{symbol}/market_chart"
            params = {
                "vs_currency": "usd",
                "days": days,
                "interval": "daily" if days > 90 else "hourly"
            }
            
            async with httpx.AsyncClient(timeout=30.0) as client:
                response = await client.get(url, params=params)
                response.raise_for_status()
                data = response.json()
            
            # Convert to OHLC format (simplified - using price as OHLC)
            prices = data["prices"]
            volumes = data["total_volumes"]
            
            ohlc_data = []
            for i, (timestamp, price) in enumerate(prices):
                volume = volumes[i][1] if i < len(volumes) else 0
                # Simplified OHLC where O=H=L=C=price
                ohlc_data.append([timestamp, price, price, price, price, volume])
            
            cache_manager.set(cache_key, ohlc_data)
            return ohlc_data
            
        except Exception as e:
            logger.error(f"Error fetching historical data: {str(e)}")
            return []
    
    async def get_trending_coins(self) -> List[Dict[str, Any]]:
        """Get trending cryptocurrencies from CoinGecko"""
        cache_key = "trending_coins"
        cached_data = cache_manager.get(cache_key)
        if cached_data:
            return cached_data
        
        await rate_limiter.wait_if_needed()
        
        try:
            url = f"{self.coingecko_url}/search/trending"
            
            async with httpx.AsyncClient(timeout=30.0) as client:
                response = await client.get(url)
                response.raise_for_status()
                data = response.json()
            
            trending = []
            for coin in data["coins"]:
                trending.append({
                    "id": coin["item"]["id"],
                    "name": coin["item"]["name"],
                    "symbol": coin["item"]["symbol"],
                    "market_cap_rank": coin["item"]["market_cap_rank"],
                    "thumb": coin["item"]["thumb"]
                })
            
            cache_manager.set(cache_key, trending)
            return trending
            
        except Exception as e:
            logger.error(f"Error fetching trending coins: {str(e)}")
            return []

# Technical Analysis Engine
class TechnicalAnalyzer:
    def __init__(self):
        self.indicators_available = PANDAS_TA_AVAILABLE
    
    def calculate_indicators(self, price_data: List[List[float]], indicators: List[str]) -> Dict[str, List[float]]:
        """Calculate technical indicators using pandas-ta"""
        if not self.indicators_available:
            return {"error": "pandas-ta not available"}
        
        try:
            # Convert price data to DataFrame
            df = pd.DataFrame(price_data, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
            df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')
            df.set_index('timestamp', inplace=True)
            
            results = {}
            
            for indicator in indicators:
                if indicator == "sma":
                    results["sma_20"] = df.ta.sma(length=20).fillna(0).tolist()
                    results["sma_50"] = df.ta.sma(length=50).fillna(0).tolist()
                elif indicator == "ema":
                    results["ema_12"] = df.ta.ema(length=12).fillna(0).tolist()
                    results["ema_26"] = df.ta.ema(length=26).fillna(0).tolist()
                elif indicator == "rsi":
                    results["rsi"] = df.ta.rsi(length=14).fillna(50).tolist()
                elif indicator == "macd":
                    macd_data = df.ta.macd()
                    if macd_data is not None:
                        results["macd"] = macd_data.iloc[:, 0].fillna(0).tolist()
                        results["macd_signal"] = macd_data.iloc[:, 1].fillna(0).tolist()
                        results["macd_histogram"] = macd_data.iloc[:, 2].fillna(0).tolist()
                elif indicator == "bb":
                    bb_data = df.ta.bbands()
                    if bb_data is not None:
                        results["bb_upper"] = bb_data.iloc[:, 0].fillna(0).tolist()
                        results["bb_middle"] = bb_data.iloc[:, 1].fillna(0).tolist()
                        results["bb_lower"] = bb_data.iloc[:, 2].fillna(0).tolist()
            
            return results
            
        except Exception as e:
            logger.error(f"Error calculating indicators: {str(e)}")
            return {"error": str(e)}
    
    def generate_signals(self, indicators: Dict[str, List[float]]) -> Dict[str, str]:
        """Generate buy/sell/hold signals based on indicators"""
        signals = {}
        
        try:
            # RSI signals
            if "rsi" in indicators and indicators["rsi"]:
                latest_rsi = indicators["rsi"][-1]
                if latest_rsi < 30:
                    signals["rsi"] = "buy"
                elif latest_rsi > 70:
                    signals["rsi"] = "sell"
                else:
                    signals["rsi"] = "hold"
            
            # MACD signals
            if "macd" in indicators and "macd_signal" in indicators:
                if len(indicators["macd"]) > 1 and len(indicators["macd_signal"]) > 1:
                    macd_current = indicators["macd"][-1]
                    macd_signal_current = indicators["macd_signal"][-1]
                    macd_prev = indicators["macd"][-2]
                    macd_signal_prev = indicators["macd_signal"][-2]
                    
                    # Bullish crossover
                    if macd_prev <= macd_signal_prev and macd_current > macd_signal_current:
                        signals["macd"] = "buy"
                    # Bearish crossover
                    elif macd_prev >= macd_signal_prev and macd_current < macd_signal_current:
                        signals["macd"] = "sell"
                    else:
                        signals["macd"] = "hold"
            
            # SMA crossover signals
            if "sma_20" in indicators and "sma_50" in indicators:
                if len(indicators["sma_20"]) > 1 and len(indicators["sma_50"]) > 1:
                    sma20_current = indicators["sma_20"][-1]
                    sma50_current = indicators["sma_50"][-1]
                    sma20_prev = indicators["sma_20"][-2]
                    sma50_prev = indicators["sma_50"][-2]
                    
                    # Golden cross
                    if sma20_prev <= sma50_prev and sma20_current > sma50_current:
                        signals["sma_cross"] = "buy"
                    # Death cross
                    elif sma20_prev >= sma50_prev and sma20_current < sma50_current:
                        signals["sma_cross"] = "sell"
                    else:
                        signals["sma_cross"] = "hold"
            
        except Exception as e:
            logger.error(f"Error generating signals: {str(e)}")
        
        return signals

# Portfolio Manager
class PortfolioManager:
    def __init__(self, data_provider: CryptoDataProvider):
        self.data_provider = data_provider
    
    async def update_portfolio_value(self, user_id: str) -> Optional[Portfolio]:
        """Update portfolio with current market prices"""
        portfolio = storage.load_portfolio(user_id)
        if not portfolio:
            return None
        
        # Get current prices for all holdings
        symbols = list(portfolio.holdings.keys())
        if not symbols:
            return portfolio
        
        current_prices = await self.data_provider.get_crypto_prices(symbols)
        
        total_value = 0
        total_change_24h = 0
        
        for symbol, quantity in portfolio.holdings.items():
            if symbol in current_prices:
                price_data = current_prices[symbol]
                holding_value = quantity * price_data.current_price
                total_value += holding_value
                
                if price_data.price_change_24h:
                    total_change_24h += quantity * price_data.price_change_24h
        
        # Update portfolio
        portfolio.total_value_usd = total_value
        portfolio.total_change_24h = total_change_24h
        portfolio.total_change_percentage_24h = (total_change_24h / (total_value - total_change_24h)) * 100 if total_value > total_change_24h else 0
        portfolio.updated_at = datetime.now().isoformat()
        
        # Save updated portfolio
        storage.save_portfolio(user_id, portfolio)
        
        return portfolio

# Alert Manager
class AlertManager:
    def __init__(self, data_provider: CryptoDataProvider):
        self.data_provider = data_provider
    
    async def check_alerts(self, user_id: str) -> List[PriceAlert]:
        """Check and trigger price alerts"""
        alerts = storage.load_alerts(user_id)
        if not alerts:
            return []
        
        active_alerts = [alert for alert in alerts if alert.is_active]
        if not active_alerts:
            return []
        
        # Get current prices for all alert symbols
        symbols = list(set(alert.symbol for alert in active_alerts))
        current_prices = await self.data_provider.get_crypto_prices(symbols)
        
        triggered_alerts = []
        
        for alert in active_alerts:
            if alert.symbol in current_prices:
                current_price = current_prices[alert.symbol].current_price
                alert.current_value = current_price
                
                should_trigger = False
                
                if alert.alert_type == AlertType.PRICE_ABOVE and current_price >= alert.target_value:
                    should_trigger = True
                elif alert.alert_type == AlertType.PRICE_BELOW and current_price <= alert.target_value:
                    should_trigger = True
                elif alert.alert_type == AlertType.PERCENT_CHANGE:
                    price_data = current_prices[alert.symbol]
                    if price_data.price_change_percentage_24h and abs(price_data.price_change_percentage_24h) >= alert.target_value:
                        should_trigger = True
                
                if should_trigger:
                    alert.is_active = False
                    alert.triggered_at = datetime.now().isoformat()
                    triggered_alerts.append(alert)
        
        # Save updated alerts
        storage.save_alerts(user_id, alerts)
        
        return triggered_alerts

# Initialize components
data_provider = CryptoDataProvider()
technical_analyzer = TechnicalAnalyzer()
portfolio_manager = PortfolioManager(data_provider)
alert_manager = AlertManager(data_provider)

