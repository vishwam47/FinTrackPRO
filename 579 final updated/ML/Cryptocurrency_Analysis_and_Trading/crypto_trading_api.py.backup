        "status": "healthy",
        "timestamp": datetime.now().isoformat(),
        "services": {
            "coingecko_api": "available",
            "technical_analysis": "available" if PANDAS_TA_AVAILABLE else "limited",
            "data_storage": "available"
        },
        "rate_limit": {
            "calls_per_minute": settings.RATE_LIMIT_PER_MINUTE,
            "cache_duration": settings.CACHE_DURATION_SECONDS
        }
    }

# Market Data Endpoints
@app.get("/crypto/prices")
async def get_crypto_prices(
    symbols: List[str] = Query(
        default=["bitcoin", "ethereum", "binancecoin"],
        description="Cryptocurrency symbols to fetch"
    )
):
    """Get current prices for specified cryptocurrencies"""
    try:
        prices = await data_provider.get_crypto_prices(symbols)
        
        return {
            "success": True,
            "data": prices,
            "count": len(prices),
            "timestamp": datetime.now().isoformat()
        }
    
    except Exception as e:
        logger.error(f"Error fetching prices: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to fetch prices: {str(e)}")

@app.get("/crypto/price/{symbol}")
async def get_single_crypto_price(symbol: str):
    """Get current price for a single cryptocurrency"""
    try:
        prices = await data_provider.get_crypto_prices([symbol])
        
        if symbol not in prices:
            raise HTTPException(status_code=404, detail=f"Cryptocurrency '{symbol}' not found")
        
        return {
            "success": True,
            "data": prices[symbol],
            "timestamp": datetime.now().isoformat()
        }
    
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Error fetching price for {symbol}: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Failed to fetch price: {str(e)}")

@app.get("/crypto/chart/{symbol}")
async def get_price_chart(
    symbol: str,
    days: int = Query(30, ge=1, le=365, description="Number of days of historical data"),
    indicators: List[TechnicalIndicator] = Query(
        default=[TechnicalIndicator.SMA, TechnicalIndicator.RSI],
        description="Technical indicators to include"
    )
):
    """Get price chart data with technical indicators"""
    try:
        # Get historical price data
        price_data = await data_provider.get_historical_data(symbol, days)
        
        if not price_data:
            raise HTTPException(status_code=404, detail=f"No historical data found for '{symbol}'")
        
        # Calculate technical indicators
        indicator_names = [ind.value for ind in indicators]
        calculated_indicators = technical_analyzer.calculate_indicators(price_data, indicator_names)
        
        # Generate trading signals
        signals = technical_analyzer.generate_signals(calculated_indicators)
        
        return {
            "success": True,
            "data": {
                "symbol": symbol,
                "price_data": price_data,
                "indicators": calculated_indicators,
                "signals": signals,
                "period_days": days
